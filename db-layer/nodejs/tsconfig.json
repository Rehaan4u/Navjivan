{
    "compilerOptions" : {
        "target": "ES2020",
        "module": "commonjs",
        "moduleResolution": "node",
        "outDir": "/dist",
        "rootDir": "./" , 
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": false,
        "skipLibCheck": true,
        "resolveJsonModule": true
  } ,
  "include" : [
    "db.ts" , 
    "storage.ts" , 
    "schema.ts" 
  ],
  //Excluded the node_modules cause the dependencies also have the .ts files and we don't want to config them
  "exclude" : [
    "node_modules",
    "dist"
  ]
}
